rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // FUNCIONES HELPER
    // ============================================

    // Verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario tiene un rol específico
    function hasRole(role) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Verifica si el usuario es admin
    function isAdmin() {
      return hasRole('admin');
    }

    // Verifica si el usuario es docente o admin
    function isDocenteOrAdmin() {
      return hasRole('docente') || hasRole('admin');
    }

    // Verifica si el usuario es el dueño del documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }


    // ============================================
    // REGLAS PARA COLECCIÓN: salas
    // ============================================
    match /salas/{salaId} {
      // Lectura: Cualquier usuario autenticado puede ver las salas
      allow read: if isAuthenticated();

      // Escritura: Solo administradores pueden crear/modificar/eliminar salas
      allow create, update, delete: if isAdmin();
    }


    // ============================================
    // REGLAS PARA COLECCIÓN: reservas
    // ============================================
    match /reservas/{reservaId} {
      // Lectura: Cualquier usuario autenticado puede ver las reservas
      allow read: if isAuthenticated();

      // Creación: Solo docentes y admins pueden crear reservas
      allow create: if isDocenteOrAdmin() &&
                       request.resource.data.usuarioId == request.auth.uid &&
                       request.resource.data.estado == 'activa';

      // Actualización: Solo el dueño o admin puede modificar
      allow update: if (isOwner(resource.data.usuarioId) || isAdmin()) &&
                       // No se puede cambiar el usuarioId ni la salaId una vez creada
                       request.resource.data.usuarioId == resource.data.usuarioId &&
                       request.resource.data.salaId == resource.data.salaId;

      // Eliminación: Solo admin puede eliminar (no se usa, se hace soft delete)
      allow delete: if isAdmin();
    }


    // ============================================
    // REGLAS PARA COLECCIÓN: users
    // ============================================
    match /users/{userId} {
      // Lectura: El propio usuario puede ver sus datos
      // ADMIN puede ver todos los usuarios para gestión
      allow read: if isOwner(userId) || isAdmin();

      // Creación: El usuario puede crear su propio documento al registrarse
      allow create: if isOwner(userId) &&
                       request.resource.data.role == 'estudiante'; // Por defecto, rol estudiante

      // Actualización: El usuario puede actualizar sus propios datos
      // EXCEPTO el rol (solo admin puede cambiar roles)
      allow update: if (isOwner(userId) &&
                       request.resource.data.role == resource.data.role) ||
                       isAdmin(); // Admin puede cambiar cualquier cosa

      // Eliminación: Solo admin
      allow delete: if isAdmin();
    }


    // ============================================
    // REGLAS PARA COLECCIÓN: notificaciones (Futuro)
    // ============================================
    match /notificaciones/{notifId} {
      // Lectura: Solo el usuario dueño de la notificación
      allow read: if isAuthenticated() &&
                     resource.data.usuarioId == request.auth.uid;

      // Escritura: Solo el sistema (Cloud Functions) o admin
      allow write: if isAdmin();
    }


    // ============================================
    // BLOQUEAR TODO LO DEMÁS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
